# ─────────────────────────────────────────────
# Скопируйте этот файл в .env.local и заполните
# cp .env.example .env.local
# ─────────────────────────────────────────────


# ── Posiflora API ─────────────────────────────
# Ключ авторизации — найти в личном кабинете posiflora → Настройки → API
POSIFLORA_API_KEY=

# Базовый URL API (уточнить версию в документации)
POSIFLORA_API_URL=https://posiflora.com/api

# ID магазина в системе posiflora
POSIFLORA_SHOP_ID=


# ── Уведомления (будущее) ─────────────────────
# SMS / WhatsApp через SMSC, СМС-Центр или иной шлюз
# Нужны для напоминаний клиенту и подтверждения доставки
SMS_API_KEY=
SMS_SENDER=Olala


# ── Карты (уже используется) ──────────────────
# Mapbox — токен для виджета выбора адреса доставки
# https://account.mapbox.com
NEXT_PUBLIC_MAPBOX_TOKEN=


# ── PostgreSQL ────────────────────────────────
# Локально: docker compose up -d && DATABASE_URL ниже
# Продакшен: postgresql://USER:PASS@127.0.0.1:5432/olala
DATABASE_URL=postgresql://olala:olala@127.0.0.1:5432/olala


# ── Instagram (фон лендинга) ──────────────────
# Username без @ — посты тянутся на сервере через HTTP-прокси
INSTAGRAM_USERNAME=
INSTAGRAM_PROXY_HOST=
INSTAGRAM_PROXY_PORT=
INSTAGRAM_PROXY_USER=
INSTAGRAM_PROXY_PASS=
